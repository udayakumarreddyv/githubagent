# GitHub Configuration (Required)
GITHUB_TOKEN=your_github_personal_access_token_here
WEBHOOK_SECRET=your_webhook_secret_here

# Server Configuration
PORT=3000

# Workspace Configuration
WORKSPACE_DIR=./workspace

# FREE AI Configuration - Choose ONE option for enhanced code generation:

# Option 1: Ollama (100% Free, Local AI - RECOMMENDED)
# Download from: https://ollama.ai
# Install model: ollama pull codellama:7b (or qwen2:0.5b for faster responses)
# Start service: ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# Option 2: Hugging Face (Free Tier)
# Get free API key from: https://huggingface.co
# HUGGINGFACE_API_KEY=your_hf_token_here
# HF_MODEL=microsoft/DialoGPT-medium

# Option 3: Google Gemini (Generous Free Tier) 
# Get free API key from: https://makersuite.google.com
# GOOGLE_API_KEY=your_google_api_key_here

# Multi-Agent Orchestration Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
EMAIL_NOTIFICATION_GROUPS=developers,managers
ORCHESTRATION_TIMEOUT=900000

# Email Configuration (Optional - for notifications)
# SMTP settings for sending notifications when PRs are created
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Email Groups (comma-separated email addresses)
EMAIL_DEV_TEAM=dev1@company.com,dev2@company.com
EMAIL_MANAGERS=manager1@company.com,pm@company.com
EMAIL_QA_TEAM=qa1@company.com,qa2@company.com

# AWS Configuration (Required for DeployAgent)
# AWS Account and Authentication
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# AWS Deployment Configuration
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
AWS_ECS_CLUSTER_PREFIX=github-agent
AWS_VPC_CIDR=10.0.0.0/16

# Deployment Environment Settings
DEPLOYMENT_SERVICE_NAME=github-agent-app
DEPLOYMENT_ENVIRONMENT=dev
DEPLOYMENT_CONTAINER_PORT=8080
DEPLOYMENT_HEALTH_CHECK_PATH=/actuator/health

# Resource Allocation (adjust based on your needs)
# For development: 256 CPU, 512 MB Memory
# For production: 1024 CPU, 2048 MB Memory
DEPLOYMENT_CPU=256
DEPLOYMENT_MEMORY=512
DEPLOYMENT_DESIRED_COUNT=1

# Testing Configuration (Optional - for TestAgent)
TEST_COVERAGE_THRESHOLD=80
JUNIT_VERSION=5.9.2
MOCKITO_VERSION=5.1.1
JACOCO_VERSION=0.8.8

# Notification Groups for Multi-Agent Results
NOTIFICATION_GROUPS={"developers":["dev1@company.com","dev2@company.com"],"managers":["pm@company.com","tech-lead@company.com"],"qa":["qa1@company.com","qa2@company.com"],"all":["team@company.com"]}
